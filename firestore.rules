rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "zuberimatangula@gmail.com" ||
        exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Innovations Collection: Public read for approved records, Admin full control
    match /innovations/{innovationId} {
      allow get: if isValidId(innovationId) && (
        resource.data.confidentialityLevel == 'PUBLIC' ||
        (isSignedIn() && (resource.data.confidentialityLevel == 'RESTRICTED' || isAdmin()))
      );
      allow list: if resource.data.confidentialityLevel == 'PUBLIC' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Research Papers: Public read for approved papers, Admin full control
    match /research/{researchId} {
      allow get, list: if resource.data.isApproved == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Publications & News: Public read for unarchived articles
    match /publications/{publicationId} {
      allow get, list: if resource.data.isArchived == false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Partnership Enquiries: Public submission (create), Admin read/manage
    match /partnership_enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 150 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Contact Messages: Public submission (create), Admin read/manage
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Administrators: Admin only
    match /administrators/{adminId} {
      allow read, write: if isAdmin();
    }

    // Website Settings: Public read, Admin write
    match /website_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
